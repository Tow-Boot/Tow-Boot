board_identifier=samsung-galaxyS20FER8q
baudrate=115200
bootdelay=2
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# Do not recreate or format storage. The existing nested userdata mapping is
# inherited from the working R8Q port.
preboot=if scsi scan; then \
	if part start scsi 0 userdata userdata_start && part size scsi 0 userdata userdata_size; then \
		if blkmap create root && blkmap map root 0 0x${userdata_size} linear scsi 0 0x${userdata_start}; then \
			echo Userdata block mapping ready; \
		else \
			echo ERROR: Could not map userdata; \
		fi; \
	else \
		echo ERROR: Could not find userdata on UFS; \
	fi; \
else \
	echo ERROR: UFS initialization failed; \
fi

# Device order is explicit; bootstd supplies EFI, extlinux and script scanning.
bootcmd=run boot_internal; \
run boot_sd; \
run boot_usb; \
echo ERROR: No bootable operating system found; \
run menucmd

boot_internal=bootflow scan -bG blkmap; bootflow scan -bG scsi
boot_sd=if mmc rescan; then bootflow scan -bG mmc; else echo ERROR: microSD unavailable; fi
boot_usb=if usb start; then bootflow scan -bG usb; else echo ERROR: USB host unavailable; fi
usb_storage=echo WARNING: USB exposes the entire UFS device for read/write access; \
	echo Press a phone button to exit; \
	if ums 0 scsi 0; then \
		echo USB storage stopped; \
	else \
		echo ERROR: USB storage failed; \
	fi

fastboot=fastboot -l $fastboot_addr_r usb 0
serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	setenv bootretry -1; \
	echo USB serial console enabled

menucmd=setenv bootmenu_console; \
	while test "${bootmenu_console}" != 1; do run towboot_menu; done; \
	setenv bootmenu_console
towboot_menu=tb_menu new; \
	tb_menu add 'Boot internal storage' 'Scan UFS for EFI or extlinux' 'run boot_internal; echo Boot failed; pause'; \
	tb_menu add 'Boot microSD' 'Scan the microSD card' 'run boot_sd; echo Boot failed; pause'; \
	tb_menu add 'Boot USB' 'Scan USB host storage' 'run boot_usb; echo Boot failed; pause'; \
	tb_menu separator; \
	tb_menu add 'USB mass storage' 'Expose UFS over USB' 'run usb_storage; pause'; \
	tb_menu add 'USB serial console' 'Enable the USB console' 'run serial_gadget; pause'; \
	tb_menu add 'Fastboot' 'Enter USB fastboot mode' 'run fastboot; pause'; \
	tb_menu separator; \
	tb_menu add 'Firmware Console' 'Use run menucmd to return' 'setenv bootmenu_console 1'; \
	tb_menu add 'Reboot' 'Restart the phone' 'reset'; \
	tb_menu add 'Shutdown' 'Power off the phone' 'poweroff'; \
	tb_menu show

button_cmd_0_name=Volume Down
button_cmd_0=setenv bootdelay -1; run menucmd
button_cmd_1_name=Volume Up
button_cmd_1=setenv bootdelay -1; run usb_storage; run menucmd
